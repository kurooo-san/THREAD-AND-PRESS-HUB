# =====================================================================
# Thread & Press Hub — environment configuration (EXAMPLE)
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# Only placeholders belong in this file.
# =====================================================================

# --- Gemini API (chatbot / AI features) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Database ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=threadpresshub
DB_PORT=3306

# --- Application ---
APP_NAME=Thread and Press Hub
APP_ENV=development
APP_DEBUG=true

# --- Email / SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password_here
MAIL_FROM=your_email@example.com
MAIL_FROM_NAME=Thread & Press Hub

# --- Store info ---
STORE_EMAIL=support@example.com
STORE_PHONE=+63 (02) 0000-0000
STORE_ADDRESS=Philippines

# --- Google reCAPTCHA v2 ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Multi-Factor Authentication (Email OTP) ---
MFA_ENABLED=true
MFA_OTP_LENGTH=6
MFA_OTP_TTL_MINUTES=10

# --- HTTPS (set true in production) ---
FORCE_HTTPS=false

# --- Manual QR Payment ---
# Days to keep payment proof screenshots after an order is completed/cancelled
# before the cleanup script deletes them (Data Privacy Act retention).
PAYMENT_PROOF_RETENTION_DAYS=90

# --- PayMongo (online payment gateway) ---
# Dashboard -> Developers -> API Keys. Use the sk_test_/pk_test_ pair while
# testing; nothing is really charged with test keys.
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
# From the response when you register the webhook (see paymongo-webhook.php).
# Without it every webhook is rejected, which is deliberate.
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret_here
# Channels offered on the hosted page. Only list what your PayMongo account
# has actually been approved for, or the checkout call fails with a 400.
PAYMONGO_METHODS=gcash,paymaya,card,grab_pay

# --- Public site URL ---
# Used to build the success/cancel URLs PayMongo redirects back to. Leave blank
# on XAMPP (it is derived from the request); set it once deployed.
APP_URL=
