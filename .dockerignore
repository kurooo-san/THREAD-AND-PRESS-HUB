# =========================================================
# Keeps secrets, customer data and dead weight out of the image.
#
# .gitignore does NOT apply to `docker build` — without this file the
# COPY step would bake .env and the database dumps into a published
# image layer, where they are readable by anyone who pulls it.
# =========================================================

# ---- Secrets -------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---- Unauthenticated maintenance scripts ---------------------------
update_admin.php
scripts/test_email.php
composer-setup.php
composer.phar
scripts/seed_payment_demo.php
scripts/insert_sample_products.php
scripts/remove_product.php
scripts/migrate.php

# ---- Real customer data (RA 10173) ---------------------------------
database/dumps/
**/threadpresshub*.sql
**/backup_*.sql
**/*.dump

# Runtime uploads live on a Railway volume, not in the image.
uploads/
storage/payment-proofs/
storage/payment-config/

# ---- Rebuilt during the image build --------------------------------
vendor/

# ---- Not needed at runtime -----------------------------------------
tests/
phpunit.xml
server.js
package.json
.git/
.github/
.claude/
.vscode/
.idea/
*.md
!README.md
docs/
css/style_backup.css

# ---- Local / OS ----------------------------------------------------
*.bak
*.log
*.tmp
.DS_Store
Thumbs.db
desktop.ini
